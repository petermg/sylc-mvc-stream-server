# SyLC MVC Stream Server 0.7 public alpha
# Intended for a trusted LAN or VPN. Do not expose this port directly to the Internet.
SYLC_BIND_HOST=0.0.0.0
SYLC_PORT=8097

# Runtime application settings. Media libraries and the optional API token are
# managed from the web UI and stored in this JSON file.
SYLC_CONFIG_FILE=/var/lib/sylc-mvc-stream/config.json

# Initial migration only: old installations may retain SYLC_MEDIA_ROOTS here.
# A new installation should leave it blank and use the first-run web setup.
SYLC_MEDIA_ROOTS=

# The server-side folder browser is intentionally limited to these roots.
# Users can still type another absolute path manually and test access.
SYLC_BROWSE_ROOTS=/mnt|/media|/srv|/home

SYLC_STATE_ROOT=/srv/sylc-mvc-stream/state
SYLC_ENGINE_PROJECT=/srv/sylc-mvc-stream/engine/phase6-streaming
SYLC_ENGINE_RUNNER=/srv/sylc-mvc-stream/engine/run-phase6-streaming-session.sh
SYLC_ENGINE_WRAPPER=/srv/sylc-mvc-stream/engine/run-phase6-streaming-session.sh

# Hardware encode is recommended. Set software only when no usable VA-API
# device exists. The server-side MVC decode and stereo composition remain CPU work.
SYLC_ENCODER_MODE=vaapi
SYLC_VAAPI_DEVICE=/dev/dri/renderD128

SYLC_MIN_READY_SEGMENTS=2
SYLC_SCAN_CACHE_SECONDS=30
SYLC_MAX_MEDIA_RESULTS=5000
SYLC_SESSION_TTL_HOURS=24
SYLC_CLEANUP_INTERVAL_SECONDS=3600
SYLC_MINIMUM_FREE_GIB=10
SYLC_EMERGENCY_FREE_GIB=5
SYLC_STOP_GRACE_SECONDS=5
SYLC_STARTUP_TIMEOUT_SECONDS=60
SYLC_STALL_TIMEOUT_SECONDS=30
